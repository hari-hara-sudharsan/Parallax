# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Use a FRESH testnet-only wallet. Never put a key that holds real funds here.

# ── Deployer wallet (same key is used on every testnet) ──────────────────────
PRIVATE_KEY=0x_your_testnet_private_key

# ── RPCs (public endpoints from the official docs; swap in Alchemy/QuickNode if rate-limited)
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
BASE_SEPOLIA_RPC=https://sepolia.base.org
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
LASNA_RPC=https://lasna-rpc.rnk.dev/

# ── Chain IDs (source: deployments/addresses.md) ─────────────────────────────
UNICHAIN_SEPOLIA_CHAIN_ID=1301
BASE_SEPOLIA_CHAIN_ID=84532
LASNA_CHAIN_ID=5318007

# ── Uniswap v4 on Unichain Sepolia (source: Uniswap docs, v4 deployments) ────
POOL_MANAGER=0x00b036b58a818b1bc34d502d3fe730db729e62ac
POSITION_MANAGER=0xf969aee60879c54baaed9f3ed26147db216fd664
STATE_VIEW=0xc199f1072a74d4e905aba1a84d9a45e2546b6222
POOL_SWAP_TEST=0x9140a78c1a137c7ff1c151ec8231272af78a99a4
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# ── Reactive (source: Reactive docs, Omni testnet chain table) ───────────────
SYSTEM_CONTRACT=0x8888888888888888888888888888888888888888
UNICHAIN_CALLBACK_PROXY=0x775c9B990ADe401060B78D0e98684eEf8d2466C1
BASE_CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585

# ── Filled in by our scripts as we deploy (see deployments/addresses.md) ─────
MOCK_WETH=
MOCK_USDC=
POOL_ID=
TRIPWIRE_REACTIVE=
TRIPWIRE_EXECUTOR=
